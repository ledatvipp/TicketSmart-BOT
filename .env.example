# Runtime
NODE_ENV=production
PORT=3001
API_URL=http://127.0.0.1:3001
DATABASE_URL="file:./data.db"

# Public dashboard origin. Production values must use HTTPS.
PUBLIC_BASE_URL=https://ticket.example.com
WEB_ORIGIN=https://ticket.example.com
TRUST_PROXY=1
COOKIE_SECURE=true

# Discord bot and OAuth
BOT_TOKEN=
CLIENT_ID=
GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://ticket.example.com/auth/callback

# Generate independent random values, never reuse them.
JWT_SECRET=
BOT_API_SECRET=
# 32 random bytes encoded as base64, e.g. `openssl rand -base64 32`.
WEBHOOK_ENCRYPTION_KEY=
JWT_ISSUER=discord-smart-ticket-system
JWT_AUDIENCE=ticket-dashboard
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# API limits
API_JSON_LIMIT=1mb
UPLOAD_JSON_LIMIT=8mb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
EXPENSIVE_RATE_LIMIT=20

# Outgoing webhook worker
WEBHOOK_WORKER_INTERVAL_MS=5000
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_MAX_PAYLOAD_BYTES=131072
WEBHOOK_BATCH_SIZE=20
WEBHOOK_PROCESSING_TIMEOUT_MS=120000
WEBHOOK_RETENTION_DAYS=90

# CSV channel IDs được phép nhận transcript từ dashboard.
TRANSCRIPT_CHANNEL_ALLOWLIST=

# Optional real AI via OpenRouter. Có thể để OPENROUTER_API_KEY trống và nhập key trong Dashboard → Smart AI.
# Key lưu từ Dashboard được AES-256-GCM bằng WEBHOOK_ENCRYPTION_KEY và được ưu tiên hơn .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_ANSWER_MODEL=
OPENROUTER_TRIAGE_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Discord Smart Ticket

# One-time compatibility flags; keep disabled unless performing a controlled migration.
ALLOW_LEGACY_PLAINTEXT_REFRESH=false
ALLOW_LEGACY_BODY_REFRESH=false
ALLOW_INSECURE_BOT_API=false

# Minecraft Level Chat reward worker (LobbySign ApiRequestSigner compatible).
# JSON map: server ID → an independent 32+ byte UTF-8 secret. Never store these in the dashboard/database.
MINECRAFT_LEVEL_SERVICE_SECRETS={"lobby-1":"replace-with-at-least-32-random-bytes"}
# Optional only for X-LeDat-Server: default; per-server env names also work,
# e.g. MINECRAFT_LEVEL_SERVICE_SECRET_LOBBY_1=...
MINECRAFT_LEVEL_SERVICE_SECRET=
# Each guild's chatLevelConfig assigns grants to one ID from this map. The worker
# records only a non-secret last-seen heartbeat after a successfully signed request.
